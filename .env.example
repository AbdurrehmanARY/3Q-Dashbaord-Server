NODE_ENV=development
PORT=5000

# Supabase — transaction-mode pooler (IPv4-only, port 6543).
# Percent-encode any special characters in the password (e.g. "@" -> "%40", ":" -> "%3A").
# The app forces postgres-js `prepare: false` for the transaction pooler (src/db/drizzle.ts).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Local Postgres alternative:
# DATABASE_URL=postgres://user:password@localhost:5432/label_erp

CORS_ORIGIN=*
JWT_SECRET=change-me
