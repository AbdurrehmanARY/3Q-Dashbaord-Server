{
  "name": "label-erp-server",
  "version": "1.0.0",
  "description": "Backend API for the Label Manufacturing ERP System",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/index.ts",
    "development": "tsx watch --env-file .env src/index.ts",
    "production": "npm run build && node --env-file .env.production dist/index.js",
    "build": "tsc --noEmit && tsup && tsup src/api-entry.ts --format esm --out-dir api --no-clean && node -e \"import('fs').then(fs => fs.renameSync('api/api-entry.js', 'api/index.js'))\"",
    "start": "node --env-file .env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file .env src/db/seed.ts",
    "db:seed:master": "tsx --env-file .env src/db/seed-master.ts",
    "db:copy:from-local": "tsx --env-file .env src/db/copy-from-local.ts",
    "db:migrate:production-runs": "tsx --env-file .env src/db/migrate-production-runs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset:production": "tsx --env-file .env src/db/reset-production.ts"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "globals": "^17.8.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
